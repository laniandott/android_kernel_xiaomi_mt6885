+/* Backport of fs: add path_umount() (v5.11 commit 0e4dd2fe2ffa2), needed
+ * by KernelSU on pre-5.11 kernels. */
+int path_umount(struct path *path, int flags)
+{
+	struct mount *mnt = real_mount(path->mnt);
+	int err;
+
+	if (path->dentry != path->mnt->mnt_root)
+		return -EINVAL;
+
+	if (!check_mnt(mnt))
+		return -EINVAL;
+
+	if (flags & ~(MNT_FORCE | MNT_DETACH | MNT_EXPIRE | UMOUNT_NOFOLLOW))
+		return -EINVAL;
+
+	if (!may_mount())
+		return -EPERM;
+
+	if (path->dentry->d_sb->s_type->fs_flags & FS_HAS_SUBTYPE)
+		return -ELOOP;
+
+	down_write(&namespace_sem);
+	err = do_umount(mnt, flags);
+	up_write(&namespace_sem);
+	return err;
+}
