USE_CONFIG=true

# Kernel
KERNEL_DEFCONFIG=vendor/cezanne_user_defconfig
KERNEL_FILE=Image.gz

# Clang
EXTRA_BUILD_COMMAND:

# KernelSU flags
USE_KERNELSU=false
KERNELSU_TAG=v1.0.1

# Build boot images
MAKE_BOOT_IMAGE=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/laniandott/android_kernel_xiaomi_mt6885/lineage-20.0/.github/boot.img
